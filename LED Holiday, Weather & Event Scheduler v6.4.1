            {% set events = events + [[123, today, 0, 0, 'christmas_rot_4']] %}
          {% endif %}
          {% if christmas_rot_5_actions | count > 0 and ((christmas_rot_5_schedule_mode == 'day_of_week' and today_dow in christmas_rot_5_days) or (christmas_rot_5_schedule_mode == 'interval' and christmas_rot_5_interval_anchor | trim != '' and (today - strptime(christmas_rot_5_interval_anchor, '%Y-%m-%d').date()).days % (christmas_rot_5_interval_days|int) == 0)) %}
            {% set events = events + [[124, today, 0, 0, 'christmas_rot_5']] %}
          {% endif %}
          {% if christmas_rot_6_actions | count > 0 and ((christmas_rot_6_schedule_mode == 'day_of_week' and today_dow in christmas_rot_6_days) or (christmas_rot_6_schedule_mode == 'interval' and christmas_rot_6_interval_anchor | trim != '' and (today - strptime(christmas_rot_6_interval_anchor, '%Y-%m-%d').date()).days % (christmas_rot_6_interval_days|int) == 0)) %}
            {% set events = events + [[125, today, 0, 0, 'christmas_rot_6']] %}
          {% endif %}
          {% if christmas_rot_7_actions | count > 0 and ((christmas_rot_7_schedule_mode == 'day_of_week' and today_dow in christmas_rot_7_days) or (christmas_rot_7_schedule_mode == 'interval' and christmas_rot_7_interval_anchor | trim != '' and (today - strptime(christmas_rot_7_interval_anchor, '%Y-%m-%d').date()).days % (christmas_rot_7_interval_days|int) == 0)) %}
            {% set events = events + [[126, today, 0, 0, 'christmas_rot_7']] %}
          {% endif %}
        {% endif %}
        {% for item in events %}
          {% set delta = (today - item[1]).days %}
          {% if delta >= (0-item[2]) and delta <= item[3] %}
            {% set ns.matches = ns.matches + [[item[0], delta|abs, item[4]]] %}
          {% endif %}
        {% endfor %}
        {% if ns.matches|count > 0 %}{{ (ns.matches|sort(attribute=1)|first)[2] }}
        {% else %}{{ '' }}{% endif %}
      seasonal_event_key: >-
        {% if not seasonal_defaults_enabled %}{{ '' }}
        {% elif now().month in [3,4,5] and spring_actions|count > 0 %}spring
        {% elif now().month in [6,7,8] and summer_actions|count > 0 %}summer
        {% elif now().month in [9,10,11] and fall_actions|count > 0 %}fall
        {% elif winter_actions|count > 0 %}winter
        {% else %}{{ '' }}{% endif %}
      weather_schedule_override_active: >-
        {{ weather_outside_schedule_enabled
           and not in_daily_window
           and weather_override_time_allowed
           and weather_event_key | trim != '' }}
      should_be_on: "{{ in_daily_window or weather_schedule_override_active }}"
      event_action_key: >-
        {% if weather_schedule_override_active %}{{ weather_event_key }}
        {% elif weather_priority == 'weather' and weather_event_key|trim != '' %}{{ weather_event_key }}
        {% elif calendar_event_key|trim != '' %}{{ calendar_event_key }}
        {% elif weather_event_key|trim != '' %}{{ weather_event_key }}
        {% elif seasonal_event_key|trim != '' %}{{ seasonal_event_key }}
        {% else %}normal{% endif %}
      trigger_id: "{{ trigger.id if trigger is defined and trigger.id is defined else 'manual' }}"
      previous_event_key: "{{ states(scheduler_state_helper) }}"
      lighting_window_started: >-
        {% set n = now() %}
        {% set next_rise = as_local(as_datetime(state_attr('sun.sun','next_rising'))) %}
        {% set next_set = as_local(as_datetime(state_attr('sun.sun','next_setting'))) %}
        {% set periods = [
          [period_1_enabled, period_1_start_mode, period_1_start_time, period_1_start_offset],
          [period_2_enabled, period_2_start_mode, period_2_start_time, period_2_start_offset],
          [period_3_enabled, period_3_start_mode, period_3_start_time, period_3_start_offset]
        ] %}
        {% set ns = namespace(hit=false) %}
        {% if trigger_id == 'scheduler_minute' %}
          {% for p in periods if p[0] and p[1] in ['fixed','sunrise','sunset'] %}
            {% for d in [-2,-1,0,1,2] %}
              {% if p[1] == 'fixed' %}{% set st = today_at(p[2]) + timedelta(days=d) %}
              {% elif p[1] == 'sunrise' %}{% set st = next_rise + timedelta(days=d-1, minutes=p[3]|int) %}
              {% else %}{% set st = next_set + timedelta(days=d-1, minutes=p[3]|int) %}{% endif %}
              {% if n - timedelta(seconds=60) < st <= n %}{% set ns.hit = true %}{% endif %}
            {% endfor %}
          {% endfor %}
        {% endif %}
        {{ ns.hit }}
      home_assistant_reapply: "{{ trigger_id == 'home_assistant_start' }}"
      periodic_reapply_due: >-
        {% set interval = periodic_reapply | int(0) %}
        {{ trigger_id == 'scheduler_minute'
           and interval > 0
           and ((as_timestamp(now()) | int // 60) % interval == 0) }}
      force_startup_reapply: "{{ home_assistant_reapply or lighting_window_started }}"
      force_event_reapply: "{{ force_startup_reapply or periodic_reapply_due }}"
      event_apply_reason: >-
        {% if home_assistant_reapply %}Home Assistant start
        {% elif lighting_window_started %}lighting window start
        {% elif periodic_reapply_due %}periodic reapply
        {% elif event_action_key != previous_event_key %}event change
        {% else %}none{% endif %}

