    lifecycle:
      name: Power, startup & shutdown
      icon: mdi:power-plug
      collapsed: true
      description: >
        Shared lifecycle actions. Startup runs when the scheduler changes from OFF to active and is
        reapplied at a display-window start or after Home Assistant starts while the schedule is
        active. Shutdown runs when the scheduler changes from active to OFF. Put every smart plug,
        relay, delay, or shared power step here; no one-to-one WLED/power-supply pairing is required.
      input:
        startup_actions:
          name: Startup / power-on actions
          description: >
            Runs when the scheduler transitions from OFF to active and is also reapplied at a
            display-window start or after Home Assistant starts while the schedule is active. Actions
            run in order. If a smart plug or relay powers WLED, add that power-on action first, then
            use + Add action to add a Delay so WLED can finish booting; start with 30 seconds when
            unsure. If the lights power on with WLED's boot/default preset instead of the scheduler's
            selected event, the delay is missing or too short. The selected event actions run only
            after this entire Startup sequence finishes.
          default: []
          selector:
            action:
        periodic_reapply:
          name: Reapply active event periodically
          description: >
            Optional recovery for a WLED that reboots, ignores the first preset command, or changes
            to its own boot preset while the display window is active. This reruns only the current
            event actions on a clock-aligned interval (for example every 15 minutes runs at :00, :15,
            :30 and :45); it does not rerun Startup actions, power actions, or a Startup boot delay.
            Every 15 minutes is a useful safety net for ordinary WLED preset-selection actions. Leave
            this at Never if event actions include notifications, media, or anything else that should
            not repeat.
          default: "0"
          selector:
            select:
              options:
                - label: Never
                  value: "0"
                - label: Every 15 minutes
                  value: "15"
                - label: Every 30 minutes
                  value: "30"
                - label: Every 60 minutes
                  value: "60"
        shutdown_actions:
          name: Shutdown / power-off actions
          description: >
            Runs once when the scheduler transitions from an active event to OFF. Add WLED turn-off
            actions, delays, then smart plug or relay shutdown actions in the order you want.
          default: []
          selector:
            action:
    conditions:
      name: Optional extra conditions
      icon: mdi:filter-check-outline
      collapsed: true
      description: >
        Optional safety or lifestyle rules added on top of the scheduler, such as someone being home,
        Vacation Mode being off, or a helper being enabled. Most users can leave this section closed.
      input:
        additional_conditions:
          name: Additional conditions
          description: >
            Optional. Most users should leave this empty. Add a condition only if another rule must
            also be true before automatic scheduling may change anything, such as someone being home
            or Vacation Mode being off. Tests bypass these conditions.
          default: []
          selector:
            condition:

    weather:
      name: Weather rules
      icon: mdi:weather-partly-rainy
      collapsed: true
      description: >
        Optional rain, snow, heat, and freeze event rules. Weather can compete with holidays inside the
        normal schedule or optionally wake lighting during allowed weather override hours.
      input:
        weather_enabled:
          name: Enable weather rules
          description: >
            Turns weather-based event selection on or off. If off, rain, snow, heat, and freeze actions are
            ignored.
          default: true
          selector:
            boolean:
        weather_entity:
          name: Weather entity
          description: >
            Select the Home Assistant weather entity whose hourly forecast should drive weather events.
          default: ''
          selector:
            entity:
              domain: weather
        weather_priority:
          name: Priority when weather and a holiday both match
          description: >
            When both a holiday/custom event and weather match, choose which one wins.
          default: weather
          selector:
            select:
              options:
                - label: Weather wins
                  value: weather
                - label: Holiday / custom event wins
                  value: calendar
        forecast_hours:
          name: Rain/snow look-ahead
          description: >
            How many upcoming hourly forecast entries to inspect for rain or snow. This is look-ahead, not
            how often the scheduler checks: the scheduler reevaluates every minute using the provider's
            latest hourly data. A value of 1 checks only the nearest hourly forecast block and usually reacts
            about 0–60 minutes before that block. A value of 3 can react almost three hours early. Forecast
            precision and update timing still depend on the selected weather provider.
          default: 6
          selector:
            number:
              min: 1
              max: 24
              step: 1
              unit_of_measurement: hours
        weather_outside_schedule_enabled:
          name: Allow weather to activate outside the normal schedule
          description: >
            When enabled, matching weather may activate lighting even when the normal schedule is off, but
            only during the allowed override hours.
          default: false
          selector:
            boolean:
        weather_override_start_time:
          name: Weather activation — earliest start
          description: >
            Earliest time weather is allowed to wake the lighting outside the normal schedule.
          default: '08:00:00'
          selector:
            time:
        weather_override_end_time:
          name: Weather activation — latest end
          description: >
            Latest time weather is allowed to keep lighting active outside the normal schedule.
          default: '22:00:00'
          selector:
            time:
        rain_actions:
          name: Rain actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
          selector:
            action:
        snow_actions:
          name: Snow actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
          selector:
            action:
        heat_threshold:
          name: Hot temperature threshold
          description: >
            If any checked forecast temperature reaches or exceeds this value, the Heat event may become
            active.
          default: 80
          selector:
            number:
              min: -40
              max: 130
              step: 1
              unit_of_measurement: °
        heat_actions:
          name: Heat actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
          selector:
            action:
        freeze_threshold:
          name: Cold temperature threshold
          description: >
            If any checked forecast temperature reaches or falls below this value, the Freeze event may
            become active.
          default: 32
          selector:
            number:
              min: -40
              max: 80
              step: 1
              unit_of_measurement: °
        freeze_actions:
          name: Freeze actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
          selector:
            action:
    defaults:
      name: Normal & seasonal actions
      icon: mdi:theme-light-dark
      collapsed: true
      description: >
        Normal/default runs when no higher-priority event matches. Seasonal actions can optionally
        replace Normal during spring, summer, fall, or winter.
      input:
        normal_actions:
          name: Normal/default actions
          description: >
            Runs when the scheduler is active and no holiday, custom event, weather rule, or enabled
            seasonal rule wins.
          default: []
          selector:
            action:
        seasonal_defaults_enabled:
          name: Enable seasonal defaults
          description: >
            When enabled, spring, summer, fall, or winter actions can replace Normal when no higher-priority
            event wins.
          default: false
          selector:
            boolean:
        spring_actions:
          name: Spring actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
