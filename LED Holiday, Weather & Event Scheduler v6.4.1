blueprint:
  name: WLED Holiday, Weather & Event Scheduler v6.4.1 Display Activation Windows
  description: >
    Display activation windows with independent fixed, solar, illuminance, or irradiance boundaries. The scheduler decides WHEN and WHICH event is active;
    native Home Assistant action builders decide WHAT every WLED, smart light, scene, switch, script,
    relay, or other device does. No primary WLED is required. Every user-facing setting includes a
    short plain-English explanation. Start with Core schedule, create/select the required Text helper,
    then configure Startup, Event, and Shutdown actions. Testing is isolated under Testing & diagnostics.
  domain: automation
  homeassistant:
    min_version: 2025.10.0

  input:
    help:
      name: Setup guide & help
      icon: mdi:book-open-page-variant
      collapsed: true
      description: >
        QUICK START — 1) Create one Text helper under Settings > Devices & services > Helpers and
        select it in Display activation schedule. 2) Set your timing. 3) Under Startup / power-on
        actions, add shared smart-plug/relay power steps. If WLED needs time to boot, use + Add action
        to place a Delay after power-on; start with 30 seconds when unsure. If the lights come on
        showing WLED's boot/default preset instead of the selected scheduler event, the delay is
        missing or too short. Event actions run only after the full Startup sequence finishes.
        4) For each normal, holiday, weather, seasonal, or custom event, use + Add action to turn on
        each WLED and then Select option on that WLED's Preset or Playlist entity. 5) Put shared
        turn-off/power-down steps under Shutdown / power-off actions. 6) To test, choose a TEST mode
        under Testing & diagnostics, Save, then click Run actions once. Use Startup + selected event
        to test the complete power, boot-delay, and preset sequence. If a test turns devices on
        outside their schedule, run Shutdown actions only before returning Test mode to Automatic —
        Normal scheduler operation. Automatic chooses the winning event; Normal/default is only the
        fallback event when no higher-priority rule wins.
      input:
        help_read_only_note:
          name: Setup guide note
          description: >
            This switch does nothing and is intentionally optional. It only gives Home Assistant a
            real input so this collapsed help section can render. Leave it off.
          default: false
          selector:
            boolean:

    core:
      name: Display activation schedule
      icon: mdi:clock-outline
      collapsed: true
      description: >
        Configure up to three daily display activation periods. Each period has its own start and end
        method: fixed time, sunrise, sunset, illuminance, or irradiance. The display is active whenever
        any enabled period is active. Use different start and end thresholds to prevent rapid cycling.
      input:
        scheduler_state_helper:
          name: Scheduler memory helper
          description: Required. Select a Text helper used to remember the active event.
          default: ''
          selector:
            entity:
              domain: input_text
        illuminance_sensor:
          name: Illuminance sensor
          description: Optional unless an illuminance start or end method is selected.
          default: ''
          selector:
            entity:
              domain: sensor
              device_class: illuminance
        irradiance_sensor:
          name: Irradiance sensor
          description: Optional unless an irradiance start or end method is selected. Normally reports W/m².
          default: ''
          selector:
            entity:
              domain: sensor
        period_1_enabled:
          name: Display activation period 1 - enable
          default: true
          selector:
            boolean:
        period_1_start_mode:
          name: Display activation period 1 - start method
          default: sunset
          selector:
            select:
              options:
                - label: Fixed time
                  value: fixed
                - label: Sunrise with offset
                  value: sunrise
                - label: Sunset with offset
                  value: sunset
                - label: Illuminance at or below threshold
                  value: illuminance
                - label: Irradiance at or below threshold
                  value: irradiance
        period_1_start_time:
          name: Display activation period 1 - fixed start time
          default: '17:00:00'
          selector:
            time:
        period_1_start_offset:
          name: Display activation period 1 - start solar offset
          default: -15
          selector:
            number: {min: -360, max: 360, step: 5, unit_of_measurement: min}
        period_1_start_lux:
          name: Display activation period 1 - start illuminance threshold
          default: 500
          selector:
            number: {min: 0, max: 100000, step: 10, unit_of_measurement: lx}
        period_1_start_irradiance:
          name: Display activation period 1 - start irradiance threshold
          default: 50
          selector:
            number: {min: 0, max: 1500, step: 5, unit_of_measurement: W/m²}
        period_1_end_mode:
          name: Display activation period 1 - end method
          default: fixed
          selector:
            select:
              options:
                - label: Fixed time
                  value: fixed
                - label: Sunrise with offset
                  value: sunrise
                - label: Sunset with offset
                  value: sunset
                - label: Illuminance below threshold
                  value: illuminance
                - label: Irradiance below threshold
                  value: irradiance
        period_1_end_time:
          name: Display activation period 1 - fixed end time
          default: '23:00:00'
          selector:
            time:
        period_1_end_offset:
          name: Display activation period 1 - end solar offset
          default: 0
          selector:
            number: {min: -360, max: 360, step: 5, unit_of_measurement: min}
        period_1_end_lux:
          name: Display activation period 1 - end illuminance threshold
          description: Keep this above the start threshold to provide hysteresis.
          default: 750
          selector:
            number: {min: 0, max: 100000, step: 10, unit_of_measurement: lx}
        period_1_end_irradiance:
          name: Display activation period 1 - end irradiance threshold
          description: Keep this above the start threshold to provide hysteresis.
          default: 100
          selector:
            number: {min: 0, max: 1500, step: 5, unit_of_measurement: W/m²}
        period_2_enabled:
          name: Display activation period 2 - enable
          default: false
          selector:
            boolean:
        period_2_start_mode:
          name: Display activation period 2 - start method
          default: fixed
          selector:
            select:
              options:
                - label: Fixed time
                  value: fixed
                - label: Sunrise with offset
                  value: sunrise
                - label: Sunset with offset
                  value: sunset
                - label: Illuminance at or below threshold
                  value: illuminance
                - label: Irradiance at or below threshold
                  value: irradiance
        period_2_start_time:
          name: Display activation period 2 - fixed start time
          default: '05:30:00'
          selector:
            time:
        period_2_start_offset:
          name: Display activation period 2 - start solar offset
          default: -15
          selector:
            number: {min: -360, max: 360, step: 5, unit_of_measurement: min}
        period_2_start_lux:
