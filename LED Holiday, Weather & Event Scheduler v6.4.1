            Leaving this empty disables this event.
          default: []
          selector:
            action:
        fall_actions:
          name: Fall actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
          selector:
            action:
        winter_actions:
          name: Winter actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
          selector:
            action:
    popular_holidays:
      name: Popular & U.S. holidays
      icon: mdi:calendar-star
      collapsed: true
      description: >
        Familiar holidays kept visible for discovery. Leaving a holiday's action list empty disables it.
      input:
        new_years_day_before:
          name: New Year's Day — days before
          description: >
            Start New Year's Day this many days before its actual date. Set 0 to start on the holiday
            itself.
          default: 0
          selector:
            number:
              min: 0
              max: 60
              step: 1
              mode: slider
        new_years_day_after:
          name: New Year's Day — days after
          description: >
            Keep New Year's Day active this many days after its actual date. Set 0 to stop after the holiday
            date.
          default: 0
          selector:
            number:
              min: 0
              max: 60
              step: 1
              mode: slider
        new_years_day_actions:
          name: New Year's Day actions
          description: >
            Use + Add action to define exactly what should happen for this event. Add as many WLED
            controllers, regular lights, scenes, switches, scripts, or other Home Assistant actions as
            you need. For WLED, add Turn on, then add Select option. Choose that WLED's Preset or Playlist
            entity, such as select.dig_uno_holidays_preset; Home Assistant then shows its available options. Each WLED may use a different preset, playlist, or native effect.
            Leaving this empty disables this event.
          default: []
