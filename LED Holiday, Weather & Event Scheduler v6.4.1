        {% if valentines_day_actions | count > 0 %}{% set events = events + [[2, strptime('%04d-02-14' | format(y), '%Y-%m-%d').date(), valentines_day_before|int, valentines_day_after|int, 'valentines_day']] %}{% endif %}
        {% if presidents_day_actions | count > 0 %}{% set events = events + [[3, (strptime('%04d-02-01' | format(y), '%Y-%m-%d').date() + timedelta(days=((0 - strptime('%04d-02-01' | format(y), '%Y-%m-%d').date().weekday()) % 7) + 7*(3-1))), presidents_day_before|int, presidents_day_after|int, 'presidents_day']] %}{% endif %}
        {% if st_patricks_day_actions | count > 0 %}{% set events = events + [[4, strptime('%04d-03-17' | format(y), '%Y-%m-%d').date(), st_patricks_day_before|int, st_patricks_day_after|int, 'st_patricks_day']] %}{% endif %}
        {% if easter_actions | count > 0 %}{% set events = events + [[5, easter_date, easter_before|int, easter_after|int, 'easter']] %}{% endif %}
        {% if mothers_day_actions | count > 0 %}{% set events = events + [[6, (strptime('%04d-05-01' | format(y), '%Y-%m-%d').date() + timedelta(days=((6 - strptime('%04d-05-01' | format(y), '%Y-%m-%d').date().weekday()) % 7) + 7*(2-1))), mothers_day_before|int, mothers_day_after|int, 'mothers_day']] %}{% endif %}
        {% if memorial_day_actions | count > 0 %}{% set events = events + [[7, ((strptime('%04d-06-01' | format(y), '%Y-%m-%d').date() - timedelta(days=1)) - timedelta(days=((strptime('%04d-06-01' | format(y), '%Y-%m-%d').date() - timedelta(days=1)).weekday() - 0) % 7)), memorial_day_before|int, memorial_day_after|int, 'memorial_day']] %}{% endif %}
        {% if fathers_day_actions | count > 0 %}{% set events = events + [[8, (strptime('%04d-06-01' | format(y), '%Y-%m-%d').date() + timedelta(days=((6 - strptime('%04d-06-01' | format(y), '%Y-%m-%d').date().weekday()) % 7) + 7*(3-1))), fathers_day_before|int, fathers_day_after|int, 'fathers_day']] %}{% endif %}
        {% if juneteenth_actions | count > 0 %}{% set events = events + [[9, strptime('%04d-06-19' | format(y), '%Y-%m-%d').date(), juneteenth_before|int, juneteenth_after|int, 'juneteenth']] %}{% endif %}
        {% if independence_day_actions | count > 0 %}{% set events = events + [[10, strptime('%04d-07-04' | format(y), '%Y-%m-%d').date(), independence_day_before|int, independence_day_after|int, 'independence_day']] %}{% endif %}
        {% if labor_day_actions | count > 0 %}{% set events = events + [[11, (strptime('%04d-09-01' | format(y), '%Y-%m-%d').date() + timedelta(days=((0 - strptime('%04d-09-01' | format(y), '%Y-%m-%d').date().weekday()) % 7) + 7*(1-1))), labor_day_before|int, labor_day_after|int, 'labor_day']] %}{% endif %}
        {% if halloween_actions | count > 0 %}{% set events = events + [[12, strptime('%04d-10-31' | format(y), '%Y-%m-%d').date(), halloween_before|int, halloween_after|int, 'halloween']] %}{% endif %}
        {% if veterans_day_actions | count > 0 %}{% set events = events + [[13, strptime('%04d-11-11' | format(y), '%Y-%m-%d').date(), veterans_day_before|int, veterans_day_after|int, 'veterans_day']] %}{% endif %}
        {% if thanksgiving_actions | count > 0 %}{% set events = events + [[14, (strptime('%04d-11-01' | format(y), '%Y-%m-%d').date() + timedelta(days=((3 - strptime('%04d-11-01' | format(y), '%Y-%m-%d').date().weekday()) % 7) + 7*(4-1))), thanksgiving_before|int, thanksgiving_after|int, 'thanksgiving']] %}{% endif %}
        {% if christmas_eve_actions | count > 0 %}{% set events = events + [[15, strptime('%04d-12-24' | format(y), '%Y-%m-%d').date(), christmas_eve_before|int, christmas_eve_after|int, 'christmas_eve']] %}{% endif %}
        {% if christmas_day_actions | count > 0 %}{% set events = events + [[16, strptime('%04d-12-25' | format(y), '%Y-%m-%d').date(), christmas_day_before|int, christmas_day_after|int, 'christmas_day']] %}{% endif %}
        {% if new_years_eve_actions | count > 0 %}{% set events = events + [[17, strptime('%04d-12-31' | format(y), '%Y-%m-%d').date(), new_years_eve_before|int, new_years_eve_after|int, 'new_years_eve']] %}{% endif %}
        {% if custom_1_date | regex_match('^\\d{2}-\\d{2}$') and custom_1_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_1_date),'%Y-%m-%d').date() %}
          {% set events = events + [[101, cd, custom_1_before|int, custom_1_after|int, 'custom_1']] %}
        {% endif %}
        {% if custom_2_date | regex_match('^\\d{2}-\\d{2}$') and custom_2_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_2_date),'%Y-%m-%d').date() %}
          {% set events = events + [[102, cd, custom_2_before|int, custom_2_after|int, 'custom_2']] %}
        {% endif %}
        {% if custom_3_date | regex_match('^\\d{2}-\\d{2}$') and custom_3_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_3_date),'%Y-%m-%d').date() %}
          {% set events = events + [[103, cd, custom_3_before|int, custom_3_after|int, 'custom_3']] %}
        {% endif %}
