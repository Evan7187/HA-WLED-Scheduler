    christmas_rotation:
      name: Christmas season preset rotation
      icon: mdi:calendar-sync
      collapsed: true
      description: >
        Rotate through up to seven different presets across the Christmas season, independent of the
        single-day Christmas Eve / Christmas Day events above. Define the season window below, then
        configure each of the seven slots: assign it either specific day(s) of the week (e.g. slot 1
        = Monday, slot 2 = Tuesday...) or a repeating interval (e.g. every 2 days, every 3 days,
        weekly). Leave a slot's actions empty to disable it. If more than one enabled slot matches the
        same day, the lowest-numbered slot wins. Christmas Eve / Christmas Day above still take
        priority over the rotation on those two specific dates if you've given them their own actions.
      input:
        christmas_rotation_start_date:
          name: Christmas rotation — season start (MM-DD)
          description: >
            Enter MM-DD for the first day the rotation should be active, e.g. 12-01. Leave blank to
            disable the whole rotation feature.
          default: '12-01'
          selector:
            text:
        christmas_rotation_end_date:
          name: Christmas rotation — season end (MM-DD)
          description: >
            Enter MM-DD for the last day the rotation should be active, e.g. 12-25. If this is earlier
            in the calendar than the start date, the season is treated as spanning the New Year (e.g.
            12-01 to 01-06). Leave blank to disable the whole rotation feature.
          default: '12-25'
          selector:
            text:
        christmas_rot_1_name:
          name: Christmas rotation slot 1 name
          description: >
            Optional friendly label for this rotation slot, e.g. "Blue & white" or "Candy cane".
            The schedule mode and actions below control behavior.
          default: ''
          selector:
            text:
        christmas_rot_1_schedule_mode:
          name: Christmas rotation slot 1 — schedule mode
          description: >
            Day of week: this preset plays on the selected weekday(s), every week, for the whole
            Christmas season below. Repeating interval: this preset plays every N days counting from
            the anchor date, regardless of weekday (use this for 2-day, 3-day, or custom cycles).
          default: day_of_week
          selector:
            select:
              mode: dropdown
              options:
                - label: Day(s) of the week
                  value: day_of_week
                - label: Repeating interval (every N days)
                  value: interval
        christmas_rot_1_days:
          name: Christmas rotation slot 1 — days of week
          description: >
            Used only when schedule mode is "Day(s) of the week." Select every weekday this preset
            should play. Leave empty if you're using the repeating interval mode instead.
          default: []
          selector:
            select:
              multiple: true
              mode: list
              options:
                - label: Monday
                  value: mon
                - label: Tuesday
                  value: tue
                - label: Wednesday
                  value: wed
                - label: Thursday
                  value: thu
                - label: Friday
                  value: fri
                - label: Saturday
                  value: sat
                - label: Sunday
                  value: sun
        christmas_rot_1_interval_days:
          name: Christmas rotation slot 1 — repeat every N days
          description: >
            Used only when schedule mode is "Repeating interval." This preset plays every N days,
            counting from the anchor date below (e.g. 2 = every other day, 7 = weekly).
          default: 7
          selector:
            number:
              min: 1
              max: 60
              step: 1
              mode: slider
        christmas_rot_1_interval_anchor:
          name: Christmas rotation slot 1 — anchor date
          description: >
            Used only when schedule mode is "Repeating interval." The interval is counted from this
            date (any past or future date works — only the day-count offset matters). Required for
            interval mode; leave day-of-week mode's days empty if you set this instead.
          default: ''
          selector:
            date:
        christmas_rot_1_actions:
          name: Christmas rotation slot 1 actions
          description: >
            Use + Add action to define exactly what should happen when this slot is active. Add as
            many WLED controllers, regular lights, scenes, switches, scripts, or other Home Assistant
            actions as you need. Leaving this empty disables this rotation slot.
          default: []
          selector:
            action:
