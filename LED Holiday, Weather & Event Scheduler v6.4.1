  # Fetch hourly forecasts only when weather is configured.
  - choose:
      - conditions:
          - condition: template
            value_template: "{{ weather_enabled and weather_entity | trim != '' }}"
        sequence:
          - action: weather.get_forecasts
            target:
              entity_id: !input weather_entity
            data:
              type: hourly
            response_variable: weather_response
    default:
