          {% set events = events + [[104, cd, custom_4_before|int, custom_4_after|int, 'custom_4']] %}
        {% endif %}
        {% if custom_5_date | regex_match('^\\d{2}-\\d{2}$') and custom_5_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_5_date),'%Y-%m-%d').date() %}
          {% set events = events + [[105, cd, custom_5_before|int, custom_5_after|int, 'custom_5']] %}
        {% endif %}
        {% if custom_6_date | regex_match('^\\d{2}-\\d{2}$') and custom_6_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_6_date),'%Y-%m-%d').date() %}
          {% set events = events + [[106, cd, custom_6_before|int, custom_6_after|int, 'custom_6']] %}
        {% endif %}
        {% if custom_7_date | regex_match('^\\d{2}-\\d{2}$') and custom_7_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_7_date),'%Y-%m-%d').date() %}
          {% set events = events + [[107, cd, custom_7_before|int, custom_7_after|int, 'custom_7']] %}
        {% endif %}
        {% if custom_8_date | regex_match('^\\d{2}-\\d{2}$') and custom_8_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_8_date),'%Y-%m-%d').date() %}
          {% set events = events + [[108, cd, custom_8_before|int, custom_8_after|int, 'custom_8']] %}
        {% endif %}
        {% if custom_9_date | regex_match('^\\d{2}-\\d{2}$') and custom_9_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_9_date),'%Y-%m-%d').date() %}
          {% set events = events + [[109, cd, custom_9_before|int, custom_9_after|int, 'custom_9']] %}
        {% endif %}
        {% if custom_10_date | regex_match('^\\d{2}-\\d{2}$') and custom_10_actions | count > 0 %}
          {% set cd = strptime('%04d-%s' | format(y,custom_10_date),'%Y-%m-%d').date() %}
          {% set events = events + [[110, cd, custom_10_before|int, custom_10_after|int, 'custom_10']] %}
        {% endif %}
        {% set rot_actions_counts = [christmas_rot_1_actions|count, christmas_rot_2_actions|count, christmas_rot_3_actions|count, christmas_rot_4_actions|count, christmas_rot_5_actions|count, christmas_rot_6_actions|count, christmas_rot_7_actions|count] %}
        {% if christmas_rotation_start_date | regex_match('^\\d{2}-\\d{2}$') and christmas_rotation_end_date | regex_match('^\\d{2}-\\d{2}$') and (rot_actions_counts | max) > 0 %}
          {% set rot_start = strptime('%04d-%s' | format(y, christmas_rotation_start_date), '%Y-%m-%d').date() %}
          {% set rot_end = strptime('%04d-%s' | format(y, christmas_rotation_end_date), '%Y-%m-%d').date() %}
          {% set in_christmas_season = (rot_start <= today <= rot_end) if rot_end >= rot_start else (today >= rot_start or today <= rot_end) %}
        {% else %}
          {% set in_christmas_season = false %}
        {% endif %}
        {% if in_christmas_season %}
          {% set dow_codes = ['mon','tue','wed','thu','fri','sat','sun'] %}
          {% set today_dow = dow_codes[today.weekday()] %}
          {% if christmas_rot_1_actions | count > 0 and ((christmas_rot_1_schedule_mode == 'day_of_week' and today_dow in christmas_rot_1_days) or (christmas_rot_1_schedule_mode == 'interval' and christmas_rot_1_interval_anchor | trim != '' and (today - strptime(christmas_rot_1_interval_anchor, '%Y-%m-%d').date()).days % (christmas_rot_1_interval_days|int) == 0)) %}
            {% set events = events + [[120, today, 0, 0, 'christmas_rot_1']] %}
          {% endif %}
          {% if christmas_rot_2_actions | count > 0 and ((christmas_rot_2_schedule_mode == 'day_of_week' and today_dow in christmas_rot_2_days) or (christmas_rot_2_schedule_mode == 'interval' and christmas_rot_2_interval_anchor | trim != '' and (today - strptime(christmas_rot_2_interval_anchor, '%Y-%m-%d').date()).days % (christmas_rot_2_interval_days|int) == 0)) %}
            {% set events = events + [[121, today, 0, 0, 'christmas_rot_2']] %}
          {% endif %}
          {% if christmas_rot_3_actions | count > 0 and ((christmas_rot_3_schedule_mode == 'day_of_week' and today_dow in christmas_rot_3_days) or (christmas_rot_3_schedule_mode == 'interval' and christmas_rot_3_interval_anchor | trim != '' and (today - strptime(christmas_rot_3_interval_anchor, '%Y-%m-%d').date()).days % (christmas_rot_3_interval_days|int) == 0)) %}
