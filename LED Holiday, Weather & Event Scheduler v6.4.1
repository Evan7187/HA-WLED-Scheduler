  - variables:
      active_window: >-
        {% set n = now() %}
        {% set lux_ok = illuminance_sensor | trim != '' and states(illuminance_sensor) not in ['unknown','unavailable','none',''] %}
        {% set lux = states(illuminance_sensor) | float(999999) %}
        {% set irr_ok = irradiance_sensor | trim != '' and states(irradiance_sensor) not in ['unknown','unavailable','none',''] %}
        {% set irr = states(irradiance_sensor) | float(999999) %}
        {% set next_rise = as_local(as_datetime(state_attr('sun.sun','next_rising'))) %}
        {% set next_set = as_local(as_datetime(state_attr('sun.sun','next_setting'))) %}
        {% set periods = [
          [1, period_1_enabled, period_1_start_mode, period_1_start_time, period_1_start_offset, period_1_start_lux, period_1_start_irradiance, period_1_end_mode, period_1_end_time, period_1_end_offset, period_1_end_lux, period_1_end_irradiance],
          [2, period_2_enabled, period_2_start_mode, period_2_start_time, period_2_start_offset, period_2_start_lux, period_2_start_irradiance, period_2_end_mode, period_2_end_time, period_2_end_offset, period_2_end_lux, period_2_end_irradiance],
          [3, period_3_enabled, period_3_start_mode, period_3_start_time, period_3_start_offset, period_3_start_lux, period_3_start_irradiance, period_3_end_mode, period_3_end_time, period_3_end_offset, period_3_end_lux, period_3_end_irradiance]
        ] %}
        {% set ns = namespace(result='off') %}
        {% for p in periods if p[1] %}
          {% set starts = namespace(items=[]) %}
          {% set ends = namespace(items=[]) %}
          {% for d in [-2,-1,0,1,2] %}
            {% if p[2] == 'fixed' %}{% set starts.items = starts.items + [today_at(p[3]) + timedelta(days=d)] %}
            {% elif p[2] == 'sunrise' %}{% set starts.items = starts.items + [next_rise + timedelta(days=d-1, minutes=p[4]|int)] %}
            {% elif p[2] == 'sunset' %}{% set starts.items = starts.items + [next_set + timedelta(days=d-1, minutes=p[4]|int)] %}{% endif %}
            {% if p[7] == 'fixed' %}{% set ends.items = ends.items + [today_at(p[8]) + timedelta(days=d)] %}
            {% elif p[7] == 'sunrise' %}{% set ends.items = ends.items + [next_rise + timedelta(days=d-1, minutes=p[9]|int)] %}
            {% elif p[7] == 'sunset' %}{% set ends.items = ends.items + [next_set + timedelta(days=d-1, minutes=p[9]|int)] %}{% endif %}
          {% endfor %}
          {% if p[2] in ['illuminance','irradiance'] %}
            {% set starts.items = [today_at('12:00:00') - timedelta(days=1), today_at('12:00:00')] %}
          {% endif %}
          {% for st in starts.items %}
            {% set ea = namespace(value=none) %}
            {% if p[7] not in ['illuminance','irradiance'] %}
              {% for candidate in ends.items | sort if candidate > st and ea.value is none %}{% set ea.value = candidate %}{% endfor %}
            {% endif %}
            {% set start_met = (p[2] not in ['illuminance','irradiance']) or (p[2] == 'illuminance' and lux_ok and lux <= p[5]|float) or (p[2] == 'irradiance' and irr_ok and irr <= p[6]|float) %}
            {% if p[7] in ['illuminance','irradiance'] %}
              {% set end_met = (p[7] == 'illuminance' and lux_ok and lux < p[10]|float) or (p[7] == 'irradiance' and irr_ok and irr < p[11]|float) %}
              {% if start_met and end_met and st <= n < st + timedelta(days=1) %}{% set ns.result = 'period_' ~ p[0] %}{% endif %}
            {% elif ea.value is not none and start_met and st <= n < ea.value %}{% set ns.result = 'period_' ~ p[0] %}{% endif %}
          {% endfor %}
        {% endfor %}
        {{ ns.result }}
      in_daily_window: "{{ active_window != 'off' }}"
      weather_event_key: >-
        {% if not weather_enabled or weather_entity | trim == '' %}{{ '' }}
        {% else %}
          {% set forecasts = weather_response.get(weather_entity, {}).get('forecast', []) %}
          {% set upcoming = forecasts[:forecast_hours|int] %}
          {% set conditions = upcoming | map(attribute='condition') | list %}
          {% set temps = upcoming | selectattr('temperature','defined') | map(attribute='temperature') | list %}
          {% set rain_conditions = ['rainy','pouring','lightning-rainy'] %}
          {% set snow_conditions = ['snowy','snowy-rainy'] %}
          {% if conditions | select('in', snow_conditions) | list | count > 0 and snow_actions | count > 0 %}weather_snow
          {% elif conditions | select('in', rain_conditions) | list | count > 0 and rain_actions | count > 0 %}weather_rain
          {% elif temps | count > 0 and temps | max >= heat_threshold|float and heat_actions | count > 0 %}weather_heat
          {% elif temps | count > 0 and temps | min <= freeze_threshold|float and freeze_actions | count > 0 %}weather_freeze
          {% else %}{{ '' }}{% endif %}
        {% endif %}
      weather_override_time_allowed: >-
        {% set n = now() %}
        {% set s = today_at(weather_override_start_time) %}
        {% set e = today_at(weather_override_end_time) %}
        {% if e <= s %}{{ n >= s or n < e }}
        {% else %}{{ s <= n < e }}{% endif %}
      calendar_event_key: >-
        {% set ns = namespace(matches=[]) %}
        {% set y = now().year %}
        {% set today = now().date() %}
        {% set aa = y % 19 %}{% set bb = y // 100 %}{% set cc = y % 100 %}
        {% set dd = bb // 4 %}{% set ee = bb % 4 %}{% set ff = (bb + 8) // 25 %}
        {% set gg = (bb - ff + 1) // 3 %}{% set hh = (19*aa + bb - dd - gg + 15) % 30 %}
        {% set ii = cc // 4 %}{% set kk = cc % 4 %}{% set ll = (32 + 2*ee + 2*ii - hh - kk) % 7 %}
        {% set mm = (aa + 11*hh + 22*ll) // 451 %}
        {% set em = (hh + ll - 7*mm + 114) // 31 %}
        {% set ed = ((hh + ll - 7*mm + 114) % 31) + 1 %}
        {% set easter_date = strptime('%04d-%02d-%02d' | format(y,em,ed),'%Y-%m-%d').date() %}
        {% set events = [] %}
        {% if new_years_day_actions | count > 0 %}{% set events = events + [[0, strptime('%04d-01-01' | format(y), '%Y-%m-%d').date(), new_years_day_before|int, new_years_day_after|int, 'new_years_day']] %}{% endif %}
