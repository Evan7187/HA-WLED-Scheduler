        period_2_start_irradiance:
          name: Display activation period 2 - start irradiance threshold
          default: 50
          selector:
            number: {min: 0, max: 1500, step: 5, unit_of_measurement: W/m²}
        period_2_end_mode:
          name: Display activation period 2 - end method
          default: fixed
          selector:
            select:
              options:
                - label: Fixed time
                  value: fixed
                - label: Sunrise with offset
                  value: sunrise
                - label: Sunset with offset
                  value: sunset
                - label: Illuminance below threshold
                  value: illuminance
                - label: Irradiance below threshold
                  value: irradiance
        period_2_end_time:
          name: Display activation period 2 - fixed end time
          default: '08:00:00'
          selector:
            time:
        period_2_end_offset:
          name: Display activation period 2 - end solar offset
          default: 0
          selector:
            number: {min: -360, max: 360, step: 5, unit_of_measurement: min}
        period_2_end_lux:
          name: Display activation period 2 - end illuminance threshold
          description: Keep this above the start threshold to provide hysteresis.
          default: 750
          selector:
            number: {min: 0, max: 100000, step: 10, unit_of_measurement: lx}
        period_2_end_irradiance:
          name: Display activation period 2 - end irradiance threshold
          description: Keep this above the start threshold to provide hysteresis.
          default: 100
          selector:
            number: {min: 0, max: 1500, step: 5, unit_of_measurement: W/m²}
        period_3_enabled:
          name: Display activation period 3 - enable
          default: false
          selector:
            boolean:
        period_3_start_mode:
          name: Display activation period 3 - start method
          default: fixed
          selector:
            select:
              options:
                - label: Fixed time
                  value: fixed
                - label: Sunrise with offset
                  value: sunrise
                - label: Sunset with offset
                  value: sunset
                - label: Illuminance at or below threshold
                  value: illuminance
                - label: Irradiance at or below threshold
                  value: irradiance
        period_3_start_time:
          name: Display activation period 3 - fixed start time
          default: '12:00:00'
          selector:
            time:
        period_3_start_offset:
          name: Display activation period 3 - start solar offset
          default: -15
          selector:
            number: {min: -360, max: 360, step: 5, unit_of_measurement: min}
        period_3_start_lux:
          name: Display activation period 3 - start illuminance threshold
          default: 500
          selector:
            number: {min: 0, max: 100000, step: 10, unit_of_measurement: lx}
        period_3_start_irradiance:
          name: Display activation period 3 - start irradiance threshold
          default: 50
          selector:
            number: {min: 0, max: 1500, step: 5, unit_of_measurement: W/m²}
        period_3_end_mode:
          name: Display activation period 3 - end method
          default: fixed
          selector:
            select:
              options:
                - label: Fixed time
                  value: fixed
                - label: Sunrise with offset
                  value: sunrise
                - label: Sunset with offset
                  value: sunset
                - label: Illuminance below threshold
                  value: illuminance
                - label: Irradiance below threshold
                  value: irradiance
        period_3_end_time:
          name: Display activation period 3 - fixed end time
          default: '13:00:00'
          selector:
            time:
        period_3_end_offset:
          name: Display activation period 3 - end solar offset
          default: 0
          selector:
